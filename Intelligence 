<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --white:#ffffff;
    --sky-wash:#eaf4ff;
    --sky-wash-2:#f5faff;
    --sky:#2f6fed;
    --sky-deep:#1c4fc2;
    --ink:#0b1220;
    --ink-soft:#3a4459;
    --muted:#5c6780;
    --navy:#0f1f3d;
    --navy-deep:#060d1e;
    --line:rgba(11,18,32,0.08);
    --glass:rgba(255,255,255,0.6);
    --glass-line:rgba(255,255,255,0.8);
    --radius-lg:28px;
    --radius-md:18px;
    --radius-sm:12px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.brand{font-family:'Space Grotesk',sans-serif;}
  img,svg{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 28px;}
  section{position:relative;}

  /* background wash */
  body{
    background:
      radial-gradient(1100px 620px at 82% -10%, var(--sky-wash) 0%, rgba(234,244,255,0) 60%),
      radial-gradient(900px 500px at -10% 20%, var(--sky-wash-2) 0%, rgba(245,250,255,0) 55%);
    background-repeat:no-repeat;
  }

  /* nav */
  header{
    position:sticky;top:0;z-index:40;
    backdrop-filter:blur(14px) saturate(160%);
    -webkit-backdrop-filter:blur(14px) saturate(160%);
    background:rgba(255,255,255,0.72);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{display:flex;align-items:center;justify-content:space-between;height:76px;}
  .brand{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:700;letter-spacing:-0.01em;}
  .brand-mark{width:30px;height:30px;border-radius:9px;background:linear-gradient(155deg,var(--sky) 0%, var(--sky-deep) 100%);position:relative;flex:none;}
  .brand-mark::after{content:"";position:absolute;inset:7px;border-radius:5px;background:var(--white);opacity:.9;}
  .nav-links{display:flex;gap:34px;font-size:14.5px;font-weight:500;color:var(--ink-soft);}
  .nav-links a:hover{color:var(--ink);}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:12px 22px;border-radius:100px;font-weight:600;font-size:14.5px;
    border:1px solid transparent;cursor:pointer;white-space:nowrap;
  }
  .btn-primary{background:var(--navy);color:var(--white);}
  .btn-primary:hover{background:var(--navy-deep);}
  .btn-sky{background:var(--sky);color:var(--white);}
  .btn-sky:hover{background:var(--sky-deep);}
  .btn-ghost{background:transparent;border-color:var(--line);color:var(--ink);}
  .btn-ghost:hover{border-color:var(--ink);}
  @media(max-width:860px){.nav-links{display:none;}}

  /* hero */
  .hero{padding:96px 0 64px;}
  .hero-grid{display:grid;grid-template-columns:1.05fr 0.85fr;gap:56px;align-items:center;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    padding:7px 14px;border-radius:100px;
    background:var(--glass);border:1px solid var(--glass-line);
    font-size:13px;font-weight:600;color:var(--sky-deep);
    box-shadow:0 1px 2px rgba(11,18,32,0.04);
    margin-bottom:22px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--sky);}
  .hero h1{
    font-size:clamp(38px,5vw,60px);
    line-height:1.04;letter-spacing:-0.02em;font-weight:700;
    margin:0 0 22px;
  }
  .hero h1 .accent{color:var(--sky);}
  .hero p.lede{font-size:18px;line-height:1.55;color:var(--muted);max-width:520px;margin:0 0 32px;}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px;}
  .hero-guarantee{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-soft);font-weight:500;}
  .hero-guarantee svg{flex:none;}
  .hero-visual{
    position:relative;aspect-ratio:1/1.05;border-radius:32px;overflow:hidden;
    background:linear-gradient(165deg,#dcebff 0%, #f6fbff 55%, #ffffff 100%);
    border:1px solid var(--line);
    box-shadow:0 30px 60px -30px rgba(47,111,237,0.35);
  }
  .orb{position:absolute;border-radius:50%;filter:blur(2px);}
  .hero-img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;}

  .orb-1{width:340px;height:340px;background:radial-gradient(circle at 35% 30%, #6fa3ff 0%, #2f6fed 55%, #1c4fc2 100%);top:8%;left:12%;opacity:0.9;animation:float 9s ease-in-out infinite;}
  .orb-2{width:150px;height:150px;background:radial-gradient(circle at 40% 35%, #14264d 0%, var(--navy) 70%);bottom:10%;right:8%;opacity:0.95;animation:float 7s ease-in-out infinite reverse;}
  @keyframes float{0%,100%{transform:translateY(0px);}50%{transform:translateY(-18px);}}
  .hero-card{
    position:absolute;left:24px;bottom:24px;right:24px;
    background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
    border:1px solid var(--glass-line);border-radius:20px;padding:18px 20px;
    display:flex;justify-content:space-between;gap:12px;
  }
  .hero-card .stat b{display:block;font-size:20px;font-family:'Space Grotesk',sans-serif;}
  .hero-card .stat span{font-size:12px;color:var(--muted);}
  .logos-row{margin-top:56px;display:flex;align-items:center;gap:28px;flex-wrap:wrap;}
  .logos-row span.label{font-size:12.5px;color:var(--muted);font-weight:600;}
  .logo-pill{padding:7px 14px;border-radius:100px;border:1px solid var(--line);font-size:13px;font-weight:600;color:var(--ink-soft);background:var(--white);}

  /* section heading pattern */
  .section-head{max-width:640px;margin:0 0 44px;}
  .section-head h2{font-size:clamp(28px,3.4vw,38px);line-height:1.12;letter-spacing:-0.015em;margin:0 0 14px;}
  .section-head p{font-size:16.5px;color:var(--muted);line-height:1.6;margin:0;}
  .section-pad{padding:88px 0;}
  .divider{height:1px;background:var(--line);}
  .kicker{display:inline-block;font-size:12.5px;font-weight:700;letter-spacing:.14em;color:var(--sky-deep);margin-bottom:14px;text-transform:uppercase;}

  /* PROOF carousel */
  .proof-section{padding:84px 0 64px;background:var(--white);}
  .proof-viewport{perspective:1600px;overflow:hidden;margin-top:36px;}
  .proof-track{
    display:flex;gap:28px;overflow-x:auto;scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;padding:44px calc(50% - 165px) 54px;
    scrollbar-width:none;-ms-overflow-style:none;
  }
  .proof-track::-webkit-scrollbar{display:none;}
  .proof-card{
    flex:0 0 330px;scroll-snap-align:center;transform-style:preserve-3d;
    will-change:transform,opacity;transition:box-shadow .3s ease;
  }
  .proof-card-inner{
    background:var(--white);border:1px solid var(--line);border-radius:24px;
    padding:38px 32px;min-height:360px;display:flex;flex-direction:column;
    box-shadow:0 34px 70px -34px rgba(11,18,32,0.22);
  }
  .proof-num{font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:700;color:var(--sky-deep);letter-spacing:.06em;}
  .proof-card h3{font-size:22px;letter-spacing:-0.01em;margin:14px 0 4px;}
  .proof-cat{display:inline-block;font-size:12px;font-weight:600;color:var(--muted);letter-spacing:.03em;margin-bottom:18px;}
  .proof-card p{font-size:14.5px;line-height:1.65;color:var(--ink-soft);margin:0;flex:1;}
  .proof-card-foot{margin-top:20px;padding-top:16px;border-top:1px solid var(--line);font-size:11.5px;color:var(--muted);}
  .proof-nav{display:flex;align-items:center;justify-content:center;gap:22px;margin-top:8px;}
  .proof-arrow{
    width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--white);
    display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--ink);cursor:pointer;
    transition:border-color .2s ease, color .2s ease;
  }
  .proof-arrow:hover{border-color:var(--sky);color:var(--sky-deep);}
  .proof-dots{display:flex;gap:8px;}
  .proof-dot{width:7px;height:7px;border-radius:50%;background:var(--line);border:none;padding:0;cursor:pointer;transition:background .2s ease, transform .2s ease;}
  .proof-dot.active{background:var(--sky-deep);transform:scale(1.3);}
  .proof-disclosure{max-width:640px;margin:26px auto 0;text-align:center;font-size:12px;color:var(--muted);}
  @media(max-width:760px){
    .proof-track{padding:36px calc(50% - 130px) 44px;}
    .proof-card{flex-basis:260px;}
    .proof-card-inner{padding:28px 22px;min-height:320px;}
  }

  /* villain section */
  .villain{background:var(--ink);color:var(--white);border-radius:var(--radius-lg);}
  .villain .wrap{padding:72px 40px;}
  .villain .section-head h2{color:var(--white);}
  .villain .section-head p{color:#aab3c9;}
  .villain-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:8px;}
  .villain-card{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:18px;padding:26px;}
  .villain-card .tag{font-size:12.5px;font-weight:700;color:var(--sky-deep);margin-bottom:10px;}
  .villain-card p{font-size:15px;line-height:1.6;color:#c7cede;margin:0;}

  /* mechanism / offer */
  .metric-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:8px;}
  .metric-card{
    background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(10px);
    border-radius:18px;padding:22px 20px;
  }
  .metric-card b{display:block;font-family:'Space Grotesk',sans-serif;font-size:26px;color:var(--sky-deep);}
  .metric-card span{font-size:13.5px;color:var(--muted);}

  .offer-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:48px;align-items:start;margin-top:48px;}
  .offer-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px;}
  .offer-list li{display:flex;gap:14px;align-items:flex-start;}
  .num{
    flex:none;width:30px;height:30px;border-radius:9px;background:var(--sky-wash);
    color:var(--sky-deep);font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:13.5px;
    display:flex;align-items:center;justify-content:center;
  }
  .offer-list h4{margin:0 0 4px;font-size:16px;}
  .offer-list p{margin:0;font-size:14.5px;color:var(--muted);line-height:1.55;}
  .guarantee-box{
    background:linear-gradient(160deg,#0b1220 0%, #1c2c4d 100%);color:var(--white);
    border-radius:22px;padding:34px;position:relative;overflow:hidden;
  }
  .guarantee-box::before{content:"";position:absolute;width:220px;height:220px;border-radius:50%;
    background:radial-gradient(circle,rgba(47,111,237,0.35),transparent 70%);top:-60px;right:-60px;}
  .guarantee-box h3{font-size:24px;margin:0 0 12px;position:relative;}
  .guarantee-box p{font-size:15px;color:#c7cede;line-height:1.65;margin:0 0 22px;position:relative;}
  .guarantee-box .fine{font-size:12.5px;color:#8b96b3;position:relative;}

  /* process */
  .process-track{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:8px;}
  .process-step{
    background:var(--white);border:1px solid var(--line);border-radius:18px;padding:22px 18px;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .process-step:hover{border-color:var(--sky);box-shadow:0 14px 30px -18px rgba(47,111,237,0.4);}
  .process-step .pn{font-family:'Space Grotesk',sans-serif;font-size:13px;color:var(--sky-deep);font-weight:700;margin-bottom:10px;}
  .process-step h4{margin:0 0 8px;font-size:15.5px;}
  .process-step p{margin:0;font-size:13.5px;color:var(--muted);line-height:1.55;}

  /* proof / work */
  .work-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:8px;}
  .work-card{
    border-radius:20px;overflow:hidden;border:1px solid var(--line);background:var(--white);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .work-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px -24px rgba(11,18,32,0.25);}
  .work-thumb{aspect-ratio:4/3;background:linear-gradient(150deg,var(--sky-wash),var(--white));display:flex;align-items:center;justify-content:center;}
  .work-body{padding:16px 18px 20px;}
  .work-body .k{font-size:11.5px;font-weight:700;color:var(--sky-deep);letter-spacing:.02em;margin-bottom:6px;}
  .work-body h4{margin:0 0 4px;font-size:15.5px;}
  .work-body p{margin:0;font-size:13px;color:var(--muted);}

  /* faq */
  .faq-list{max-width:760px;margin-top:8px;border-top:1px solid var(--line);}
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    display:flex;align-items:center;justify-content:space-between;gap:20px;
    padding:22px 4px;cursor:pointer;background:none;border:none;width:100%;text-align:left;
    font-family:'Inter',sans-serif;font-size:16px;font-weight:600;color:var(--ink);
  }
  .faq-q .plus{flex:none;width:26px;height:26px;border-radius:50%;border:1px solid var(--line);position:relative;transition:transform .25s ease, border-color .25s ease;}
  .faq-q .plus::before,.faq-q .plus::after{content:"";position:absolute;background:var(--ink-soft);}
  .faq-q .plus::before{left:7px;right:7px;top:50%;height:1.5px;transform:translateY(-50%);}
  .faq-q .plus::after{top:7px;bottom:7px;left:50%;width:1.5px;transform:translateX(-50%);}
  .faq-item.open .plus{transform:rotate(45deg);border-color:var(--sky);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  .faq-a p{margin:0 4px 22px;font-size:14.5px;color:var(--muted);line-height:1.65;max-width:640px;}

  /* contact */
  .contact-box{
    background:linear-gradient(160deg,var(--sky-wash) 0%, var(--white) 60%);
    border:1px solid var(--line);border-radius:var(--radius-lg);
    padding:64px 48px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;
  }
  .contact-box h2{font-size:clamp(26px,3vw,34px);margin:0 0 14px;letter-spacing:-0.015em;}
  .contact-box p.lede{color:var(--muted);font-size:15.5px;margin:0 0 26px;max-width:440px;}
  form.contact-form{display:flex;flex-direction:column;gap:12px;}
  .contact-form input,.contact-form textarea{
    width:100%;padding:14px 16px;border-radius:12px;border:1px solid var(--line);
    font-family:'Inter',sans-serif;font-size:14.5px;background:var(--white);
  }
  .contact-form input:focus,.contact-form textarea:focus{outline:2px solid var(--sky);outline-offset:1px;}
  .contact-form textarea{min-height:96px;resize:vertical;}

  footer{border-top:1px solid var(--line);padding:36px 0;}
  footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
  footer .fbrand{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;}
  footer .fmeta{font-size:13px;color:var(--muted);}

  :focus-visible{outline:2px solid var(--sky);outline-offset:2px;}
  @media (prefers-reduced-motion: reduce){.orb{animation:none;}}

  @media(max-width:980px){
    .hero-grid{grid-template-columns:1fr;}
    .hero-visual{order:-1;max-width:440px;}
    .villain-grid{grid-template-columns:1fr;}
    .offer-grid{grid-template-columns:1fr;}
    .process-track{grid-template-columns:repeat(2,1fr);}
    .work-grid{grid-template-columns:repeat(2,1fr);}
    .metric-row{grid-template-columns:repeat(2,1fr);}
    .contact-box{grid-template-columns:1fr;padding:40px 26px;}
  }
  @media(max-width:520px){
    .process-track{grid-template-columns:1fr;}
    .work-grid{grid-template-columns:1fr;}
  }
</style>
</head>
