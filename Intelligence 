<header>
  <nav class="wrap">
    <a href="/" class="brand"><span class="brand-mark"></span>Gromolabs</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/#proof">Proof</a>
      <a href="/#projects">Projects &amp; Decisions</a>
      <a href="/#services">Services</a>
      <a href="/intelligence.html">Intelligence</a>
      <a href="/updates.html">Updates</a>
      <a href="/#faq">FAQs</a>
      <a href="/#contact">Contact</a>
    </div>
    <a href="/#contact" class="btn btn-primary">Book a Growth Audit</a>
  </nav>
</header>

<main>
  <section class="hero" style="padding:80px 0 40px;">
    <div class="wrap">
      <span class="kicker">Intelligence</span>
      <h1 style="font-size:clamp(32px,4.4vw,48px);line-height:1.08;letter-spacing:-0.02em;font-weight:700;margin:0 0 18px;">Intelligence.</h1>
      <p class="lede" style="max-width:600px;">Research, frameworks, and analysis on what actually moves CAC and ROAS in AI-driven creative production.</p>
    </div>
  </section>

  <section class="section-pad" style="padding-top:0;">
    <div class="wrap">
      <div style="border:1px solid var(--line);border-radius:var(--radius-lg);padding:56px 40px;background:linear-gradient(160deg,var(--sky-wash) 0%, var(--white) 60%);text-align:center;">
        <p style="font-size:16px;color:var(--muted);margin:0 0 22px;max-width:520px;margin-left:auto;margin-right:auto;">Content for this page is coming soon. This is a live, styled page ready for you to fill in.</p>
        <a href="/#contact" class="btn btn-sky">Get in touch</a>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span class="fbrand">Gromolabs</span>
    <span class="fmeta">© 2026 Gromolabs. Performance creative systems for DTC growth.</span>
  </div>
</footer>

</body>
</html>
